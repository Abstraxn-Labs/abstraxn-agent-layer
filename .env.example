PORT=3011
NODE_ENV=development
CORS_ORIGINS=*

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=web3_public_mcp

# This route has no API key, so IP is the only rate-limit lever.
PUBLIC_MCP_RATE_LIMIT_PER_MIN=30
PUBLIC_MCP_RATE_LIMIT_WINDOW_MS=60000

# Only set this if deployed behind a reverse proxy/load balancer (otherwise every caller's IP
# resolves to the proxy's, breaking the rate limit above and IP tracking). "1" trusts one hop.
# TRUST_PROXY=1

# Per-chain EVM RPC overrides (safe public defaults are used if unset — see chain-registry.util.ts)
# CHAIN_RPC_ETHEREUM=
# CHAIN_RPC_SEPOLIA=
# CHAIN_RPC_POLYGON=
# CHAIN_RPC_POLYGON_AMOY=
# CHAIN_RPC_BSC=
# CHAIN_RPC_BSC_TESTNET=
# CHAIN_RPC_BASE=
# CHAIN_RPC_BASE_SEPOLIA=
# CHAIN_RPC_ARBITRUM_ONE=

# Solana RPC overrides
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# SOLANA_DEVNET_RPC_URL=https://api.devnet.solana.com

# REQUIRED — base URL for the upstream market/wallet/travel relay (never caller-controlled).
# No default is committed to source; market.crypto/web3.lookup/travel.search fail until this
# is set in your own untracked .env.
UPSTREAM_RELAY_BASE_URL=
